   "source": [
    "try:\n",
    "  a = int(input(\"割られる数を入力してください：\"))\n",
    "  b = int(input(\"割る数を入力してください：\"))\n",
    "  c = a / b\n",
    "  print(f\"{a} ÷ {b} = {c}\")\n",
    "except ZeroDivisionError:\n",
    "  print(\"0で割り算しないでください\")\n",
    "except ValueError:\n",
    "  print(\"数値を入力してください\")\n",
    "\n",
    "print(\"処理を終了します\")"
   ]
  }
 ],
